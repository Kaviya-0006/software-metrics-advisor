# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

ENV=development
DATABASE_URL=sqlite:///./software_metrics.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Used starting in Phase 6 (AI Advisor). Leave blank for now.
LLM_API_KEY=

# --- Phase 6: AI Advisor -----------------------------------------------
# Leave AI_PROVIDER as "none" (or leave these blank) to run without an AI
# Advisor — every other feature (upload, metrics, health score, risk
# detection, dashboard) works identically either way.
AI_PROVIDER=none
AI_MODEL=claude-haiku-4-5-20251001
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Option A: Anthropic (hosted, needs an API key) ---------------------
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# AI_API_KEY=your-key-here

# --- Option B: Ollama (local, no API key needed) -------------------------
# Requires Ollama installed and running separately, with the model
# already pulled (e.g. `ollama pull qwen2.5:3b`) — this application never
# installs Ollama or downloads a model for you.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
