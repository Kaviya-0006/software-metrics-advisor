NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# Prisma resolves a relative SQLite path from the prisma/ folder.
DATABASE_URL="file:./software_metrics.db"

# true = serve built-in sample data (no database or `prisma generate` needed)
USE_MOCK_DB=false

# Comma-separated browser origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

AI_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://localhost:11434
